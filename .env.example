# Variables de entorno del backend de OneWatch.
# Copiar a .env y completar. En producción se definen como App Settings de App Service.
# Los identificadores de Entra ID no son secretos (constitución §3.1, guía Azure).

# --- Microsoft Entra ID (ESP-14) ---
# Tenant corporativo: define el emisor esperado y la URL del JWKS
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Client id del registro de aplicación onewatch-api (audiencia esperada del token)
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Scope delegado requerido en el claim scp
ENTRA_API_SCOPE=access_as_user

# --- CORS ---
# Origen(es) del frontend, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- PostgreSQL ---
# Cadena de conexión al Azure PostgreSQL Flexible Server (o instancia local de desarrollo)
DATABASE_URL=postgresql://user:password@localhost:5432/onewatch
